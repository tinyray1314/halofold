+    var body: some View {
+        Group {
+            switch state {
+            case .saved: Label("已本地保存", systemImage: "checkmark").foregroundStyle(.white.opacity(0.45))
+            case .saving: Label("保存中", systemImage: "ellipsis").foregroundStyle(.white.opacity(0.45))
